#!/usr/bin/env bash
# Run THIS demo from anywhere in the repo. Your branch (e.g. m1-demo2-before) picks the demo folder,
# so you never have to cd by hand or remember the long path.
#
#   ./lab up         bring up the lab (Docker + ZAP), wait until ready
#   ./lab step 1          run step 1  (the same ./steps/01-...sh shown in the walk-through)
#   ./lab step 2|3|4      run step 2 / 3 / 4
#   ./lab down       stop the lab
#   ./lab reset      reset the lab
#   ./lab logs       show ZAP's boot log (add 'app'/'postgres'/'mongo' for another service)
#   ./lab status     show the containers and their health
#
# The course self-test is a SEPARATE, off-camera command: ./preflight-check (whole course by default,
# or --m1 / --m1d1 to scope it). It is not part of ./lab and is never run on camera.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
stem="${branch%-before}"; stem="${stem%-after}"
folder=""
for d in "$ROOT"/demos/*/"${stem}"-*/; do [ -d "$d" ] && folder="${d%/}" && break; done
if [ -z "$folder" ]; then
  echo "Can't tell which demo to run from branch '${branch:-unknown}'."
  echo "Switch to a demo branch first, for example:  git switch m1-demo2-before"
  exit 2
fi
cmd="${1:-}"
case "$cmd" in
  up)    cd "$folder" && exec ./scripts/lab-up.sh ;;
  down)  cd "$folder" && exec ./scripts/lab-down.sh ;;
  reset) cd "$folder" && exec ./scripts/lab-reset.sh ;;
  logs)   cd "$ROOT" && exec docker compose logs --tail="${3:-200}" "${2:-zap}" ;;
  status) cd "$ROOT" && exec docker compose ps ;;
  step)
    n="${2:-}"
    case "$n" in 1|2|3|4) ;; *) echo "usage: ./lab step <1|2|3|4>"; exit 2 ;; esac
    s="$(ls "$folder"/steps/0"$n"-*.sh 2>/dev/null | head -1)"
    [ -n "$s" ] || { echo "No step $n found in ${folder#"$ROOT"/}/steps"; exit 2; }
    cd "$folder" && exec "$s" ;;
  1|2|3|4)   # back-compat: ./lab 1 still runs step 1
    s="$(ls "$folder"/steps/0"$cmd"-*.sh 2>/dev/null | head -1)"
    [ -n "$s" ] || { echo "No step $cmd found in ${folder#"$ROOT"/}/steps"; exit 2; }
    cd "$folder" && exec "$s" ;;
  *) echo "usage: ./lab <up|step N|down|reset|logs|status>   (clip picked from branch: ${stem:-unknown})"; exit 2 ;;
esac
