#!/usr/bin/env bash
# Run THIS demo from anywhere in the repo. Your branch (e.g. m1-demo2-before) picks the demo folder,
# so you never have to cd by hand or remember the long path.
#
#   ./demo up         bring up the lab (Docker + ZAP), wait until ready
#   ./demo 1          run step 1  (the same ./steps/01-...sh shown in the walk-through)
#   ./demo 2|3|4      run step 2 / 3 / 4
#   ./demo preflight  run all four steps and SAVE each step's output as evidence to upload
#   ./demo down       stop the lab
#   ./demo reset      reset the lab
#   ./demo logs       show ZAP's boot log (add 'app'/'postgres'/'mongo' for another service)
#   ./demo status     show the containers and their health
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
stem="${branch%-before}"; stem="${stem%-after}"
folder=""
for d in "$ROOT"/demos/*/"${stem}"-*/; do [ -d "$d" ] && folder="${d%/}" && break; done
if [ -z "$folder" ]; then
  echo "Can't tell which demo to run from branch '${branch:-unknown}'."
  echo "Switch to a demo branch first, for example:  git switch m1-demo2-before"
  exit 2
fi
cmd="${1:-}"
case "$cmd" in
  up)    cd "$folder" && exec ./scripts/demo_up.sh ;;
  down)  cd "$folder" && exec ./scripts/demo_down.sh ;;
  reset) cd "$folder" && exec ./scripts/demo_reset.sh ;;
  preflight)
    # '--all' runs preflight for EVERY demo whose steps are present (e.g. on the integration branch
    # that carries all authored files), so you can confirm the whole course in one go. Each demo saves
    # its own logs/preflight-step-0N.log; a demo whose taught file is not authored on this branch is
    # skipped with a note, never a crash.
    if [ "${2:-}" = "--all" ]; then
      allrc=0
      for d in "$ROOT"/demos/*/*/; do
        [ -d "${d}steps" ] || continue
        echo "════════ preflight: ${d#"$ROOT"/} ════════"
        "$ROOT/runtime/scripts/preflight_all_steps.sh" "${d%/}" || allrc=1
        echo
      done
      exit "$allrc"
    fi
    # Human-in-loop gate: re-run this demo's four real named steps and save each step's visible
    # output as logs/preflight-step-0N.log, then print the exact files to hand to the author.
    "$ROOT/runtime/scripts/preflight_all_steps.sh" "$folder"; rc=$?
    if [ "$rc" -eq 0 ]; then
      echo
      echo "Preflight PASSED. Upload these evidence files to the author:"
      # print repo-relative paths only, never the absolute path (it would show the machine username)
      for f in "$folder"/logs/preflight-step-0*.log; do [ -f "$f" ] && echo "    ${f#"$ROOT"/}"; done
      echo "The author compares them against the committed evidence and reconciles any difference."
    else
      echo
      echo "Preflight did NOT pass. Fix the environment (re-run ./setup/setup-macos.sh) or the"
      echo "authored file the failing step named, then run ./demo preflight again."
    fi
    exit "$rc" ;;
  logs)   cd "$ROOT" && exec docker compose logs --tail="${3:-200}" "${2:-zap}" ;;
  status) cd "$ROOT" && exec docker compose ps ;;
  1|2|3|4)
    s="$(ls "$folder"/steps/0"$cmd"-*.sh 2>/dev/null | head -1)"
    [ -n "$s" ] || { echo "No step $cmd found in ${folder#"$ROOT"/}/steps"; exit 2; }
    cd "$folder" && exec "$s" ;;
  *) echo "usage: ./demo <up|1|2|3|4|preflight|down|reset|logs|status>   (demo picked from branch: ${stem:-unknown})"; exit 2 ;;
esac
